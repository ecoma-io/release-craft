# Dependencies — installed, never committed. The lockfile is the record.
node_modules/

# Build output — regenerated by `pnpm build`, never a source of truth.
dist/
*.tsbuildinfo

# Coverage reports — generated per run by Vitest.
coverage/

# Moon's local task cache — derived state, never a source of truth.
.moon/cache/

# Tool-local caches.
.eslintcache

# Agent worktrees live outside the tree they edit.
.claude/worktrees/

# OS noise.
.DS_Store
