{
  "name": "@ecoma-io/release-craft",
  "version": "0.1.0",
  "private": true,
  "description": "General-purpose, open-source release engine for software projects — release planning, versioning, prerelease and release lines as code. Built by ecoma-io.",
  "keywords": [
    "release-engineering",
    "versioning",
    "release-automation"
  ],
  "homepage": "https://github.com/ecoma-io/release-craft#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecoma-io/release-craft.git"
  },
  "bugs": {
    "url": "https://github.com/ecoma-io/release-craft/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Mai Ngọc Hóa (John Martin)",
    "email": "john.itvn@gmail.com"
  },
  "type": "module",
  "bin": {
    "release-craft": "./dist/src/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./domain": {
      "types": "./dist/core/domain/index.d.ts",
      "default": "./dist/core/domain/index.js"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "prepare": "lefthook install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm exec moon run ...:lint",
    "typecheck": "pnpm exec moon run ...:typecheck",
    "test": "pnpm exec moon run ...:test",
    "test:coverage": "pnpm exec vitest run --coverage",
    "build": "pnpm exec moon run release-craft:build",
    "arch": "pnpm exec moon run release-craft:arch",
    "check": "pnpm exec moon run release-craft:format-check ...:lint ...:typecheck ...:test release-craft:build release-craft:arch",
    "check:files": "node scripts/check-required-files.mjs",
    "check:package": "node scripts/check-package-contract.mjs",
    "check:workflows": "node scripts/check-workflow-safety.mjs",
    "check:docs": "node scripts/check-docs-links.mjs",
    "check:pr-description": "node scripts/check-pr-description.mjs",
    "check:policy": "pnpm run check:files && pnpm run check:package && pnpm run check:workflows && pnpm run check:docs && pnpm run check:pr-description"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@ecoma-io/archkeep": "0.24.1",
    "@eslint/js": "^10.0.1",
    "@moonrepo/cli": "^2.5.4",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
